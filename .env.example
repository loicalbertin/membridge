# Vault path local (volume mount)
VAULT_OBSIDIAN_PATH=/path/to/your/obsidian/vault

# Embedding API - Indexer
MB_IDX_EMBEDDING_API_KEY=your-api-key-here
MB_IDX_EMBEDDING_BASE_URL=http://your-embedding-api-host:port/v1
MB_IDX_EMBEDDING_MODEL=your/model/name

# Embedding API - MCP
MB_MCP_EMBEDDING_BASE_URL=http://your-embedding-api-host:port/v1
MB_MCP_EMBEDDING_API_KEY=your-api-key-here
MB_MCP_EMBEDDING_MODEL=your/model/name

# MCP server authentication (HTTP transports). Leave empty to disable auth.
# Generate a token with: openssl rand -base64 32
MB_MCP_AUTH_TOKENS=

# MCP server TLS (optional): off | manual | auto (Let's Encrypt)
MB_MCP_TLS_MODE=off
# MB_MCP_TLS_CERT=/path/to/cert.pem
# MB_MCP_TLS_KEY=/path/to/key.pem
# MB_MCP_TLS_DOMAIN=mcp.example.com
# MB_MCP_TLS_CACHE_DIR=/var/cache/membridge-certs
# MB_MCP_ACME_HTTP_ADDR=:80
